# Build output (large, and rebuilt from the source)
/target
/dist
debug

# Test pictures and anything a local run writes here
/shots

# Local databases, in case one is ever pointed at this folder (COINCRAFT_DB)
*.db
*.db-journal
*.db-wal
*.db-shm

# Rust tool leftovers: rustfmt backups, Windows debug symbols, cargo-mutants data, compiler crash reports
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Editor and system files
.DS_Store
.claude/
.vscode/
.idea/
*.swp
